<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThrHeaderBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/header_cell</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#455766</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">none</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="ThrCellBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">33dp</item>
        <item name="android:background">@drawable/table_cell</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#4B4B4B</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">none</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
    </style>

    <style name="ThrHeaderAwc" parent="ThrHeaderBase"><item name="android:layout_weight">0.70</item></style>
    <style name="ThrCellAwc" parent="ThrCellBase"><item name="android:layout_weight">0.70</item></style>

    <style name="ThrHeaderCategory" parent="ThrHeaderBase"><item name="android:layout_weight">1.50</item></style>
    <style name="ThrCellCategory" parent="ThrCellBase"><item name="android:layout_weight">1.50</item></style>

    <style name="ThrHeaderInstallment" parent="ThrHeaderBase"><item name="android:layout_weight">0.82</item></style>
    <style name="ThrCellInstallment" parent="ThrCellBase"><item name="android:layout_weight">0.82</item></style>

    <style name="ThrHeaderCount" parent="ThrHeaderBase"><item name="android:layout_weight">1.08</item></style>
    <style name="ThrCellCount" parent="ThrCellBase"><item name="android:layout_weight">1.08</item></style>

    <style name="ThrHeaderPackets" parent="ThrHeaderBase"><item name="android:layout_weight">1.10</item></style>
    <style name="ThrCellPackets" parent="ThrCellBase"><item name="android:layout_weight">1.10</item></style>

    <style name="ThrHeaderKg" parent="ThrHeaderBase"><item name="android:layout_weight">1.12</item></style>
    <style name="ThrCellKg" parent="ThrCellBase"><item name="android:layout_weight">1.12</item></style>

    <style name="ThrHeaderReceivedPackets" parent="ThrHeaderBase"><item name="android:layout_weight">1.18</item></style>
    <style name="ThrCellReceivedPackets" parent="ThrCellBase"><item name="android:layout_weight">1.18</item></style>

    <style name="ThrHeaderReceivedKg" parent="ThrHeaderBase"><item name="android:layout_weight">1.15</item></style>
    <style name="ThrCellReceivedKg" parent="ThrCellBase"><item name="android:layout_weight">1.15</item></style>
</resources>
