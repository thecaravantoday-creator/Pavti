<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7F9"
    android:padding="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <Button android:id="@+id/thrAtikamBackButton" android:layout_width="76dp" android:layout_height="32dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:background="@drawable/nav_button" android:text="BACK" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="THR-अतिकम" android:textColor="#4B5A66" android:textStyle="bold" android:textSize="18sp" android:gravity="center"/>
        <View android:layout_width="76dp" android:layout_height="1dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView style="@style/ThrHeaderCategory" android:text="हितग्राही वर्ग"/>
        <TextView style="@style/ThrHeaderInstallment" android:text="किश्त क्रमांक"/>
        <TextView style="@style/ThrHeaderCount" android:text="पात्र बच्चों की संख्या"/>
        <TextView style="@style/ThrHeaderPackets" android:text="कुल आवश्यक पैकेट संख्या"/>
        <TextView style="@style/ThrHeaderKg" android:text="कुल अपेक्षित मात्रा (Kg)"/>
        <TextView style="@style/ThrHeaderReceivedPackets" android:text="समूह से प्राप्त पैकेट संख्या"/>
        <TextView style="@style/ThrHeaderReceivedKg" android:text="कुल प्राप्त मात्रा (Kg)"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="33dp" android:orientation="horizontal" android:baselineAligned="false"><TextView style="@style/ThrCellCategory" android:text="06 से 12"/><TextView style="@style/ThrCellInstallment" android:text="--"/><TextView style="@style/ThrCellCount" android:id="@+id/a612Eligible"/><TextView style="@style/ThrCellPackets" android:id="@+id/a612Packets"/><TextView style="@style/ThrCellKg" android:id="@+id/a612ExpectedKg"/><TextView style="@style/ThrCellReceivedPackets" android:id="@+id/a612ReceivedPackets"/><TextView style="@style/ThrCellReceivedKg" android:id="@+id/a612ReceivedKg"/></LinearLayout>
