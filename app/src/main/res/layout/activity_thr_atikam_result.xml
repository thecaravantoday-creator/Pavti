    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"><TextView android:layout_width="115dp" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#4B5A66" android:text="कुल मात्रा = " android:textStyle="bold" android:textSize="15sp"/><TextView android:id="@+id/atikamSummaryKg" android:layout_width="130dp" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#4B4B4B" android:textStyle="bold" android:textSize="15sp"/></LinearLayout>
