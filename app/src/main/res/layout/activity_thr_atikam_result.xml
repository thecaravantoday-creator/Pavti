    <LinearLayout android:layout_width="match_parent" android:layout_height="33dp" android:orientation="horizontal" android:baselineAligned="false"><TextView style="@style/ThrCellCategory" android:text="25 से 36"/><TextView style="@style/ThrCellInstallment" android:text="--"/><TextView style="@style/ThrCellCount" android:id="@+id/a2536Eligible"/><TextView style="@style/ThrCellPackets" android:id="@+id/a2536Packets"/><TextView style="@style/ThrCellKg" android:id="@+id/a2536ExpectedKg"/><TextView style="@style/ThrCellReceivedPackets" android:id="@+id/a2536ReceivedPackets"/><TextView style="@style/ThrCellReceivedKg" android:id="@+id/a2536ReceivedKg"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="33dp" android:orientation="horizontal" android:baselineAligned="false"><TextView style="@style/ThrCellCategory" android:text="37 से 48"/><TextView style="@style/ThrCellInstallment" android:text="--"/><TextView style="@style/ThrCellCount" android:id="@+id/a3748Eligible"/><TextView style="@style/ThrCellPackets" android:id="@+id/a3748Packets"/><TextView style="@style/ThrCellKg" android:id="@+id/a3748ExpectedKg"/><TextView style="@style/ThrCellReceivedPackets" android:id="@+id/a3748ReceivedPackets"/><TextView style="@style/ThrCellReceivedKg" android:id="@+id/a3748ReceivedKg"/></LinearLayout>
