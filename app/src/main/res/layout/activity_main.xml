<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F6F7F9"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="आंगनवाड़ी की पावती भरने हेतु"
        android:textColor="#4B5A66"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="पावती प्रकार चुनें"
        android:textColor="#5E6D78"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="18dp"/>

    <Button
        android:id="@+id/hcmButton"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:background="@drawable/nav_button"
        android:text="HCM"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/thrButton"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:background="@drawable/nav_button"
        android:text="THR"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/thrAtikamButton"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:background="@drawable/nav_button"
        android:text="THR-अतिकम"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/hiddenAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BODHI S.H.G."
        android:textColor="#00000000"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:layout_marginTop="20dp"/>
</LinearLayout>
